[Unit]
Description=OpenASRPortal speech service
After=network.target

[Service]
Type=simple
User=openasrportal
Group=openasrportal
StateDirectory=openasr/portal
StateDirectoryMode=0700
EnvironmentFile=/var/lib/openasr/portal/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/openasrportal
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
