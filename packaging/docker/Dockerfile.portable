FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev build-essential dpkg-dev ca-certificates libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/build-env
ENV PATH=/opt/build-env/bin:$PATH
COPY requirements.txt /tmp/portal-requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir pyinstaller==6.16.0 -r /tmp/portal-requirements.txt
WORKDIR /source
