FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential dpkg-dev ca-certificates curl xz-utils libffi-dev libssl-dev \
    zlib1g-dev libbz2-dev liblzma-dev libsqlite3-dev libreadline-dev \
    && rm -rf /var/lib/apt/lists/*
# Python 3.11+ supplies TLS-in-TLS for HTTPS CONNECT proxies. Preserve the
# Ubuntu 22.04 libc baseline while pinning the private interpreter exactly.
ENV LD_LIBRARY_PATH=/opt/python/lib
RUN curl -fsSL https://www.python.org/ftp/python/3.12.10/Python-3.12.10.tar.xz -o /tmp/python.tar.xz \
    && echo '07ab697474595e06f06647417d3c7fa97ded07afc1a7e4454c5639919b46eaea  /tmp/python.tar.xz' | sha256sum -c - \
    && mkdir /tmp/python-source && tar -xJf /tmp/python.tar.xz -C /tmp/python-source --strip-components=1 \
    && cd /tmp/python-source \
    && ./configure --prefix=/opt/python --enable-shared --with-ensurepip=install \
    && make -j4 && make install \
    && rm -rf /tmp/python-source /tmp/python.tar.xz
RUN /opt/python/bin/python3.12 -m venv /opt/build-env
ENV PATH=/opt/build-env/bin:$PATH
COPY requirements.txt /tmp/portal-requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir pyinstaller==6.16.0 -r /tmp/portal-requirements.txt
WORKDIR /source
